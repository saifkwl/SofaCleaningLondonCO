---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  label: string;
  caption: string;
  beforeAlt: string;
  afterAlt: string;
  /** The first slider on a page should load eagerly for LCP */
  eager?: boolean;
  /** Caption colour, for sliders placed on the dark teal background */
  tone?: 'dark' | 'light';
}

const { id, label, caption, beforeAlt, afterAlt, eager = false, tone = 'dark' } = Astro.props;
const captionClass = tone === 'light' ? 'text-sand-200/80' : 'text-ink-800';
const labelClass = tone === 'light' ? 'text-sand-50' : 'text-ink-950';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', {
  eager: true,
});
const before = files[`../assets/gallery/${id}-before.jpg`]?.default;
const after = files[`../assets/gallery/${id}-after.jpg`]?.default;

if (!before || !after) {
  throw new Error(`BeforeAfter: missing image pair for "${id}"`);
}
---

<figure class="group">
  <div
    class="ba relative overflow-hidden rounded-card bg-ink-900 shadow-lift"
    style={`aspect-ratio: ${before.width} / ${before.height};`}
  >
    <Image
      src={after}
      alt={afterAlt}
      widths={[480, 800, 1100]}
      sizes="(min-width: 1024px) 34rem, (min-width: 640px) 46vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="ba-clip absolute inset-0 overflow-hidden">
      <Image
        src={before}
        alt={beforeAlt}
        widths={[480, 800, 1100]}
        sizes="(min-width: 1024px) 34rem, (min-width: 640px) 46vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        class="ba-before absolute inset-0 h-full w-full object-cover"
      />
    </div>

    <span
      class="pointer-events-none absolute left-3 top-3 rounded-full bg-ink-950/85 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-sand-50"
      >Before</span
    >
    <span
      class="pointer-events-none absolute right-3 top-3 rounded-full bg-zest-400 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-ink-950"
      >After</span
    >

    <span class="ba-handle pointer-events-none absolute inset-y-0 w-0.5 bg-sand-50/90">
      <span
        class="absolute top-1/2 left-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-sand-50 shadow-pop"
      >
        <svg class="h-5 w-5 text-ink-950" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7.5 6 4 10l3.5 4M12.5 6l3.5 4-3.5 4" />
        </svg>
      </span>
    </span>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      step="0.1"
      class="ba-range absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent"
      aria-label={`Reveal slider: ${label} before and after cleaning`}
    />
  </div>
  <figcaption class={`mt-3.5 text-sm leading-relaxed ${captionClass}`}>
    <span class={`font-semibold ${labelClass}`}>{label}.</span>
    {' '}{caption}
  </figcaption>
</figure>

<style>
  .ba {
    --pos: 50%;
  }
  .ba-clip {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-handle {
    left: var(--pos);
    transform: translateX(-50%);
  }
  /* The range input is an invisible control layered over the image. */
  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 3rem;
    height: 3rem;
  }
  .ba-range::-moz-range-thumb {
    width: 3rem;
    height: 3rem;
    border: 0;
    background: transparent;
  }
  .ba-range:focus-visible {
    outline: 3px solid var(--color-zest-400);
    outline-offset: 3px;
  }
</style>

<script is:inline>
  (() => {
    if (window.__baInit) return;
    window.__baInit = true;
    const bind = () => {
      document.querySelectorAll('.ba-range').forEach((input) => {
        if (input.dataset.bound) return;
        input.dataset.bound = '1';
        const frame = input.closest('.ba');
        const sync = () => frame.style.setProperty('--pos', input.value + '%');
        input.addEventListener('input', sync);
        sync();
      });
    };
    bind();
    document.addEventListener('astro:page-load', bind);
  })();
</script>
