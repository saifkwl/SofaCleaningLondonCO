---
interface Props {
  rows: { item: string; range: string; note: string }[];
  note?: string;
  title?: string;
  /** Set false where the surrounding copy already carries the estimate wording */
  disclaimer?: boolean;
}
const { rows, note, title, disclaimer = true } = Astro.props;
---

<div class="overflow-hidden rounded-card border border-ink-950/10 bg-sand-50">
  {
    title && (
      <div class="border-b border-ink-950/10 bg-sand-100 px-6 py-4">
        <h3 class="font-display text-lg font-semibold text-ink-950">{title}</h3>
      </div>
    )
  }
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">Typical price ranges{title ? ` for ${title}` : ''} — final price agreed by phone or WhatsApp</caption>
    <thead>
      <tr class="border-b border-ink-950/10 text-[0.7rem] uppercase tracking-[0.14em] text-ink-600">
        <th scope="col" class="px-6 py-3.5 font-semibold">Item</th>
        <th scope="col" class="px-6 py-3.5 text-right font-semibold">Typical range</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-950/8">
      {
        rows.map((r) => (
          <tr>
            <th scope="row" class="px-6 py-4 font-medium text-ink-950">
              {r.item}
              <span class="mt-0.5 block text-sm font-normal text-ink-700">{r.note}</span>
            </th>
            <td class="whitespace-nowrap px-6 py-4 text-right align-top font-display text-lg font-semibold text-ink-800">
              {r.range}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    note && (
      <p class="border-t border-ink-950/10 bg-sand-100 px-6 py-4 text-sm leading-relaxed text-ink-800">
        {note}
      </p>
    )
  }
  {
    disclaimer && (
      <p class="border-t border-ink-950/10 bg-sand-100 px-6 pb-4 text-[0.82rem] leading-relaxed text-ink-700">
        <strong class="font-semibold text-ink-900">Estimates, not final quotes.</strong> These are
        guide ranges based on typical London rates. A smaller or lightly soiled job can come in
        under the range, and a big or badly soiled one can sit above it. We agree your actual price
        with you on the phone or on WhatsApp before anything is booked.
      </p>
    )
  }
</div>
