---
interface Props {
  class?: string;
  tone?: 'dark' | 'light';
}
const { class: className = '', tone = 'dark' } = Astro.props;
const mark = tone === 'light' ? 'text-zest-400' : 'text-ink-700';
const word = tone === 'light' ? 'text-sand-50' : 'text-ink-950';
const sub = tone === 'light' ? 'text-ink-300' : 'text-ink-600';
---

<span class={`flex items-center gap-2.5 ${className}`}>
  <svg
    class={`h-9 w-9 shrink-0 ${mark}`}
    viewBox="0 0 40 40"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="1.25" y="1.25" width="37.5" height="37.5" rx="11" stroke="currentColor" stroke-width="2.5" />
    <path
      d="M10 24v-6.5a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3V24"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
    />
    <path
      d="M8 24.5A2.5 2.5 0 0 1 10.5 22h19a2.5 2.5 0 0 1 2.5 2.5V29H8v-4.5Z"
      fill="currentColor"
    />
    <path d="M12 29v2M28 29v2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[1.28rem] font-semibold tracking-tight ${word}`}>
      Sofa Cleaning
    </span>
    <span class={`text-[0.66rem] font-semibold uppercase tracking-[0.28em] ${sub}`}>London</span>
  </span>
</span>
