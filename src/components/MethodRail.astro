---
import { method } from '../data/method';

interface Props {
  heading?: string;
  lede?: string;
}
const {
  heading = 'Seven steps, in this order, every time',
  lede = 'The order is the method. Most of what goes wrong in this trade — patchiness, browning, shrinkage, a smell that comes back — comes from skipping a step or doing two of them the wrong way round.',
} = Astro.props;
---

<section class="container-page py-16 md:py-24" aria-labelledby="method-heading">
  <div class="max-w-2xl">
    <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>How we clean</p>
    <h2 id="method-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
      {heading}
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-ink-800">{lede}</p>
  </div>

  <ol class="mt-14 grid gap-px overflow-hidden rounded-card bg-ink-950/10 md:grid-cols-2 lg:grid-cols-3">
    {
      method.map((m) => (
        <li class="bg-sand-50 p-7">
          <span class="font-display text-[2.4rem] font-semibold leading-none text-ink-300">
            {m.n}
          </span>
          <h3 class="mt-4 text-lg font-semibold text-ink-950">{m.title}</h3>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-800">{m.body}</p>
        </li>
      ))
    }
    <li class="flex flex-col justify-center bg-ink-950 p-7 text-sand-50">
      <p class="font-display text-xl font-semibold leading-snug">
        If a fabric cannot be cleaned safely, we say so on the doorstep and do not charge you.
      </p>
      <a
        href="/how-we-clean/"
        class="mt-5 inline-flex w-fit items-center gap-2 text-sm font-bold text-zest-400 underline underline-offset-4"
      >
        Read the full method
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </li>
  </ol>
</section>
