---
import { Image } from 'astro:assets';
import { reviews } from '../data/reviews';

interface Props {
  showScreenshots?: boolean;
  limit?: number;
}
const { showScreenshots = false, limit } = Astro.props;
const list = limit ? reviews.slice(0, limit) : reviews;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/reviews/*.png', {
  eager: true,
});
---

<ul class="grid gap-5 md:grid-cols-3">
  {
    list.map((r) => {
      const shot = r.screenshot ? shots[`../assets/reviews/${r.screenshot}`]?.default : undefined;
      return (
        <li class="flex flex-col rounded-card border border-ink-950/10 bg-sand-50 p-6 shadow-lift">
          <blockquote class="relative flex-1">
            <p class="rounded-3xl rounded-bl-md bg-sand-100 p-5 text-[0.97rem] leading-relaxed text-ink-900">
              {r.body}
            </p>
          </blockquote>
          <div class="mt-4 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-ink-800 font-display text-base font-semibold text-sand-50"
            >
              {r.name.charAt(0)}
            </span>
            <div>
              <p class="font-semibold text-ink-950">{r.name}</p>
              <p class="text-sm text-ink-600">
                {r.service} · via {r.source}
              </p>
            </div>
          </div>
          {showScreenshots && shot && (
            <details class="mt-4">
              <summary class="cursor-pointer text-sm font-semibold text-ink-700 underline underline-offset-4">
                View the original message
              </summary>
              <Image
                src={shot}
                alt={`Screenshot of the ${r.source.toLowerCase()} from ${r.name}`}
                widths={[320, 520]}
                sizes="(min-width: 768px) 20rem, 85vw"
                loading="lazy"
                class="mt-3 w-full rounded-2xl border border-ink-950/10"
              />
            </details>
          )}
        </li>
      );
    })
  }
</ul>
