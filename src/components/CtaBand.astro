---
import { site, telHref, whatsappHref, defaultWhatsappMessage } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
  /** Seeds the WhatsApp message, e.g. "a corner sofa in SW18" */
  context?: string;
}
const {
  heading = 'Send us a photo. Get a fixed price back.',
  body = 'A picture from the doorway is usually all we need. We reply with a price that does not change on the day, and we will tell you honestly if something will not come out.',
  context,
} = Astro.props;

const message = context
  ? `Hi Sofa Cleaning London, I'd like a quote for ${context}. My postcode is `
  : defaultWhatsappMessage;
---

<section class="container-page py-16 md:py-20">
  <div class="relative overflow-hidden rounded-card bg-ink-950 px-7 py-14 text-sand-50 md:px-16 md:py-20">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-ink-700/50 blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-zest-400/10 blur-3xl"
    >
    </div>
    <div class="relative max-w-2xl">
      <p class="eyebrow text-zest-400"><span class="h-px w-6 bg-zest-400"></span>Free quote</p>
      <h2 class="mt-4 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">{heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-sand-200/85">{body}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappHref(message)}
          rel="noopener"
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-zest-400 px-7 py-4 text-base font-bold text-ink-950 transition-transform hover:-translate-y-px"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.96L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.1c-.25.7-1.45 1.33-2 1.4-.53.07-1.18.1-1.9-.12a16 16 0 0 1-1.73-.64 12.3 12.3 0 0 1-4.7-4.16c-.35-.47-1.1-1.56-1.1-2.98 0-1.42.74-2.12 1-2.4.26-.3.57-.37.76-.37h.55c.18 0 .42-.07.65.5l.9 2.16c.07.15.12.33.02.53-.1.2-.15.32-.3.5l-.45.52c-.15.15-.3.31-.13.61.17.3.75 1.24 1.61 2 1.11.99 2.05 1.3 2.34 1.45.3.15.47.13.64-.08l.92-1.07c.2-.25.4-.2.67-.12l2.05.97c.3.15.5.22.57.34.07.12.07.7-.18 1.4Z" />
          </svg>
          WhatsApp a photo
        </a>
        <a
          href={telHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-sand-100/25 px-7 py-4 text-base font-bold text-sand-50 transition-colors hover:border-sand-100/60"
        >
          Call {site.phoneDisplay}
        </a>
      </div>
      <p class="mt-5 text-sm text-sand-200/60">{site.hours} · Covering Greater London</p>
    </div>
  </div>
</section>
