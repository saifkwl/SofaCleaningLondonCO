---
import type { Faq } from '../data/services';

interface Props {
  faqs: Faq[];
  heading?: string;
  /** Extra intro line under the heading */
  lede?: string;
}
const { faqs, heading = 'Common questions', lede } = Astro.props;
---

<section class="container-page py-16 md:py-20" aria-labelledby="faq-heading">
  <div class="grid gap-10 lg:grid-cols-[22rem_1fr]">
    <div>
      <p class="eyebrow text-ink-600">
        <span class="h-px w-6 bg-ink-600"></span>Questions
      </p>
      <h2 id="faq-heading" class="mt-3 text-3xl font-semibold md:text-4xl">{heading}</h2>
      {lede && <p class="mt-4 leading-relaxed text-ink-800">{lede}</p>}
    </div>

    <div class="divide-y divide-ink-950/10 border-y border-ink-950/10">
      {
        faqs.map((f, i) => (
          <details class="group py-1" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg font-semibold text-ink-950">{f.q}</h3>
              <span
                aria-hidden="true"
                class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink-950/20 transition-transform group-open:rotate-45"
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M7 2v10M2 7h10" />
                </svg>
              </span>
            </summary>
            <p class="pb-6 pr-10 leading-relaxed text-ink-800">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
