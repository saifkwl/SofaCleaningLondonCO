---
import { site, telHref, whatsappHref, defaultWhatsappMessage } from '../data/site';
import { services } from '../data/services';

interface Props {
  /** Pre-selects the service dropdown, e.g. on a service page */
  preselect?: string;
  /** Pre-fills the area field, e.g. on a borough page */
  area?: string;
  compact?: boolean;
  id?: string;
}

const { preselect, area = '', compact = false, id = 'quote' } = Astro.props;
---

<form
  class="quote-form not-prose"
  id={id}
  data-wa-base={`https://wa.me/${site.whatsappNumber}`}
  novalidate
>
  <div class:list={['grid gap-4', compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2']}>
    <div class="sm:col-span-2">
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-service`}>
        What needs cleaning?
      </label>
      <select
        id={`${id}-service`}
        name="service"
        required
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 focus:border-ink-600"
      >
        <option value="">Choose a service…</option>
        {
          services.map((s) => (
            <option value={s.nav} selected={preselect === s.slug}>
              {s.nav}
            </option>
          ))
        }
        <option value="Something else">Something else</option>
      </select>
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-items`}>
        Items or rooms
      </label>
      <input
        id={`${id}-items`}
        name="items"
        type="text"
        required
        placeholder="e.g. 3-seater + 2 armchairs"
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 placeholder:text-sand-500 focus:border-ink-600"
      />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-postcode`}>
        Postcode
      </label>
      <input
        id={`${id}-postcode`}
        name="postcode"
        type="text"
        required
        autocomplete="postal-code"
        value={area}
        placeholder="e.g. SW4 7AA"
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 placeholder:text-sand-500 focus:border-ink-600"
      />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-name`}>
        Your name
      </label>
      <input
        id={`${id}-name`}
        name="name"
        type="text"
        required
        autocomplete="given-name"
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 focus:border-ink-600"
      />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-when`}>
        When suits you?
      </label>
      <select
        id={`${id}-when`}
        name="when"
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 focus:border-ink-600"
      >
        <option value="As soon as possible">As soon as possible</option>
        <option value="This week">This week</option>
        <option value="Next week">Next week</option>
        <option value="Weekend">A weekend</option>
        <option value="Evening">An evening</option>
        <option value="Just after a price">Just after a price for now</option>
      </select>
    </div>

    <div class="sm:col-span-2">
      <label class="mb-1.5 block text-sm font-semibold text-ink-950" for={`${id}-notes`}>
        Anything we should know? <span class="font-normal text-ink-600">(optional)</span>
      </label>
      <textarea
        id={`${id}-notes`}
        name="notes"
        rows="2"
        placeholder="Stains, pets, fabric type, stairs, parking…"
        class="w-full rounded-2xl border border-ink-950/15 bg-sand-50 px-4 py-3.5 text-ink-950 placeholder:text-sand-500 focus:border-ink-600"
      ></textarea>
    </div>
  </div>

  <p class="quote-error mt-3 hidden text-sm font-semibold text-red-700" role="alert"></p>

  <div class="quote-preview mt-5 hidden rounded-2xl border border-ink-950/10 bg-sand-100 p-4">
    <p class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-ink-600">
      This is the message that will open in WhatsApp
    </p>
    <pre
      class="quote-preview-text mt-2.5 overflow-x-auto whitespace-pre-wrap font-sans text-sm leading-relaxed text-ink-900"></pre>
  </div>

  <div class="mt-5 flex flex-col gap-3 sm:flex-row">
    <button
      type="submit"
      class="inline-flex flex-1 items-center justify-center gap-2.5 rounded-full bg-zest-400 px-6 py-4 text-base font-bold text-ink-950 transition-all hover:-translate-y-px hover:bg-zest-500"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.96L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.1c-.25.7-1.45 1.33-2 1.4-.53.07-1.18.1-1.9-.12a16 16 0 0 1-1.73-.64 12.3 12.3 0 0 1-4.7-4.16c-.35-.47-1.1-1.56-1.1-2.98 0-1.42.74-2.12 1-2.4.26-.3.57-.37.76-.37h.55c.18 0 .42-.07.65.5l.9 2.16c.07.15.12.33.02.53-.1.2-.15.32-.3.5l-.45.52c-.15.15-.3.31-.13.61.17.3.75 1.24 1.61 2 1.11.99 2.05 1.3 2.34 1.45.3.15.47.13.64-.08l.92-1.07c.2-.25.4-.2.67-.12l2.05.97c.3.15.5.22.57.34.07.12.07.7-.18 1.4Z" />
      </svg>
      <span class="quote-submit-label">Send on WhatsApp</span>
    </button>
    <a
      href={telHref}
      class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink-950/15 px-6 py-4 text-base font-bold text-ink-950 transition-colors hover:border-ink-950/45"
    >
      Call {site.phoneDisplay}
    </a>
  </div>

  <p class="mt-4 text-[0.8rem] leading-relaxed text-ink-700">
    Pressing the button opens WhatsApp with your details written out — you still tap send yourself,
    so nothing leaves your phone until you do. We use what you send only to quote and arrange your
    clean. See our <a class="underline underline-offset-2" href="/privacy/">privacy notice</a>.
  </p>

  <noscript>
    <p class="mt-4 rounded-2xl bg-sand-100 p-4 text-sm text-ink-900">
      This form needs JavaScript to build your message. You can
      <a class="font-semibold underline" href={whatsappHref(defaultWhatsappMessage)} rel="noopener"
        >message us on WhatsApp</a
      >
      or <a class="font-semibold underline" href={telHref}>call {site.phoneDisplay}</a> instead.
    </p>
  </noscript>
</form>

<script is:inline>
  (() => {
    if (window.__quoteInit) return;
    window.__quoteInit = true;

    const build = (form) => {
      const get = (n) => (form.elements[n]?.value || '').trim();
      const lines = [
        'Hi Sofa Cleaning London, I would like a quote.',
        '',
        'Service: ' + get('service'),
        'Items / rooms: ' + get('items'),
        'Postcode: ' + get('postcode'),
        'Name: ' + get('name'),
        'When: ' + get('when'),
      ];
      const notes = get('notes');
      if (notes) lines.push('Notes: ' + notes);
      lines.push('', 'Sent from ' + window.location.pathname);
      return lines.join('\n');
    };

    const bind = () => {
      document.querySelectorAll('.quote-form').forEach((form) => {
        if (form.dataset.bound) return;
        form.dataset.bound = '1';

        const error = form.querySelector('.quote-error');
        const preview = form.querySelector('.quote-preview');
        const previewText = form.querySelector('.quote-preview-text');
        const label = form.querySelector('.quote-submit-label');
        let confirmed = false;

        const reset = () => {
          confirmed = false;
          label.textContent = 'Send on WhatsApp';
          preview.classList.add('hidden');
        };
        form.addEventListener('input', reset);

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const missing = [...form.querySelectorAll('[required]')].filter((el) => !el.value.trim());
          if (missing.length) {
            error.textContent =
              'Please fill in: ' +
              missing
                .map((el) => form.querySelector('label[for="' + el.id + '"]')?.textContent.trim())
                .join(', ');
            error.classList.remove('hidden');
            missing[0].focus();
            return;
          }
          error.classList.add('hidden');

          const message = build(form);

          // Step one shows the message; step two opens WhatsApp. Nothing is sent
          // until the visitor presses send inside WhatsApp itself.
          if (!confirmed) {
            previewText.textContent = message;
            preview.classList.remove('hidden');
            label.textContent = 'Looks right — open WhatsApp';
            confirmed = true;
            preview.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            return;
          }

          window.open(
            form.dataset.waBase + '?text=' + encodeURIComponent(message),
            '_blank',
            'noopener'
          );
        });
      });
    };

    bind();
    document.addEventListener('astro:page-load', bind);
  })();
</script>
