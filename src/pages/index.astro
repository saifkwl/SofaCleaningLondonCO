---
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import MethodRail from '../components/MethodRail.astro';
import ReviewWall from '../components/ReviewWall.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { guides } from '../data/guides';
import { galleryPairs } from '../data/gallery';
import { site, telHref, whatsappHref, defaultWhatsappMessage } from '../data/site';

const heroPair = galleryPairs.find((p) => p.id === 'leather-sofa-1') ?? galleryPairs[0];
const showcase = ['corner-sofa-1', 'stair-carpet-2', 'velvet-accent-chair-1', 'carpet-1']
  .map((id) => galleryPairs.find((p) => p.id === id))
  .filter((p): p is (typeof galleryPairs)[number] => Boolean(p));

const homeFaqs = [
  {
    q: 'How much does sofa cleaning cost in London?',
    a: 'As a guide, a two-seater fabric sofa is typically £55–£85 and a three-seater £70–£110. Corner sofas are priced by seat count, usually £110–£215. Leather is £70–£100 for a two-seater, conditioning included. These are estimates, not quotes — a smaller or lightly soiled job can come in under the range, and a heavily soiled one above it. Send a photo on WhatsApp or ring us and we will agree your actual figure before booking.',
  },
  {
    q: 'How long will my sofa take to dry?',
    a: 'Three to five hours for upholstery and two to four for carpet, in a normally ventilated room. We extract far more moisture than we put in, so things come back damp rather than wet. An air mover cuts that substantially and we will set one up at no extra cost.',
  },
  {
    q: 'Which parts of London do you cover?',
    a: 'Greater London. We have detailed pages for twelve boroughs where we work most often — Clapham, Balham, Wandsworth, Putney, Fulham, Chelsea, Streatham, Islington, Hackney, Chiswick, Richmond and Croydon — and we cover the areas around them at the same rates.',
  },
  {
    q: 'Do you charge for a quote?',
    a: 'No. Send a photo on WhatsApp with your postcode and you get a price back, usually within the hour. We will talk it through with you so the figure is agreed before you book. If we arrive and a fabric turns out to be one we cannot clean safely, we tell you on the doorstep and there is no charge for the visit.',
  },
  {
    q: 'Is the cleaning safe for children and pets?',
    a: 'We use pH-balanced, low-odour products and rinse them out properly, which is the part that matters — residue left in fabric is what causes irritation. Keep children and pets off the furniture until it is dry to the touch.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${site.domain}/#faq`,
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Sofa & Upholstery Cleaning London | Clear Prices"
  description="Sofa, upholstery and carpet cleaning across Greater London. Fibre-tested methods, dry in 3–5 hours, clear price ranges and a real quote by phone or WhatsApp."
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950 text-sand-50">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -left-32 top-10 h-[30rem] w-[30rem] rounded-full bg-ink-700/35 blur-3xl"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-20 -bottom-40 h-[26rem] w-[26rem] rounded-full bg-zest-400/10 blur-3xl"
    >
    </div>

    <div class="container-page relative grid items-center gap-14 py-14 lg:grid-cols-[1.05fr_1fr] lg:py-20">
      <div>
        <p class="eyebrow text-zest-400">
          <span class="h-px w-6 bg-zest-400"></span>Greater London · {site.hours}
        </p>
        <h1 class="mt-5 text-[2.4rem] font-semibold leading-[1.06] md:text-[4rem]">
          The sofa you already own,
          <span class="text-zest-400"> two shades cleaner.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-sand-200/85">
          Upholstery and carpet cleaning across London. We test the fibre before we touch it, put in
          the least moisture that will do the job, and tell you honestly what will lift and what
          will not — before you book, not after.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={whatsappHref(defaultWhatsappMessage)}
            rel="noopener"
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-zest-400 px-7 py-4 text-base font-bold text-ink-950 transition-transform hover:-translate-y-px"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.96L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.1c-.25.7-1.45 1.33-2 1.4-.53.07-1.18.1-1.9-.12a16 16 0 0 1-1.73-.64 12.3 12.3 0 0 1-4.7-4.16c-.35-.47-1.1-1.56-1.1-2.98 0-1.42.74-2.12 1-2.4.26-.3.57-.37.76-.37h.55c.18 0 .42-.07.65.5l.9 2.16c.07.15.12.33.02.53-.1.2-.15.32-.3.5l-.45.52c-.15.15-.3.31-.13.61.17.3.75 1.24 1.61 2 1.11.99 2.05 1.3 2.34 1.45.3.15.47.13.64-.08l.92-1.07c.2-.25.4-.2.67-.12l2.05.97c.3.15.5.22.57.34.07.12.07.7-.18 1.4Z" />
            </svg>
            Send a photo for a price
          </a>
          <a
            href={telHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-sand-100/25 px-7 py-4 text-base font-bold text-sand-50 transition-colors hover:border-sand-100/60"
          >
            Call {site.phoneDisplay}
          </a>
        </div>

        <ul class="mt-10 grid gap-x-8 gap-y-3 text-sm text-sand-200/85 sm:grid-cols-2">
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zest-400"></span>
            Fibre and colourfastness tested before we start
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zest-400"></span>
            Dry in 3–5 hours, not the next day
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zest-400"></span>
            Clear price range upfront, agreed before we book
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zest-400"></span>
            Every photo below is a real customer job
          </li>
        </ul>
      </div>

      <div class="lg:pl-6">
        <div class="rounded-[2.25rem] bg-sand-50/5 p-3 ring-1 ring-sand-100/10">
          <BeforeAfter
            id={heroPair.id}
            label={heroPair.label}
            caption={heroPair.caption}
            beforeAlt={heroPair.beforeAlt}
            afterAlt={heroPair.afterAlt}
            eager
            tone="light"
            sizes="(min-width: 1024px) 34rem, 92vw"
          />
        </div>
        <p class="mt-4 text-center text-sm text-sand-200/60">
          Drag the handle. No filters, no stock photography.
        </p>
      </div>
    </div>
    <div class="h-10 rounded-t-[2.5rem] bg-sand-50"></div>
  </section>

  <!-- Services -->
  <section class="container-page py-16 md:py-24" aria-labelledby="services-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>What we clean</p>
        <h2 id="services-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
          Ten things we do, and do properly
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-800">
          Different fabrics fail in different ways, so they need different methods. Each of these
          pages explains what actually goes wrong with that material and how it gets fixed.
        </p>
      </div>
      <a
        href="/services/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-ink-950/15 px-5 py-3 text-sm font-bold text-ink-950 hover:border-ink-950/45"
      >
        All services
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li>
            <a
              href={`/services/${s.slug}/`}
              class="group flex h-full flex-col rounded-card border border-ink-950/10 bg-sand-50 p-7 transition-all hover:-translate-y-1 hover:border-ink-950/25 hover:shadow-lift"
            >
              <h3 class="font-display text-xl font-semibold text-ink-950">{s.nav}</h3>
              <p class="mt-2.5 flex-1 text-[0.95rem] leading-relaxed text-ink-800">{s.summary}</p>
              <p class="mt-5 flex items-center gap-2 text-sm font-bold text-ink-700">
                {s.priceRows[0].range}
                <span class="ml-auto inline-flex h-8 w-8 items-center justify-center rounded-full bg-sand-100 transition-colors group-hover:bg-zest-400">
                  <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Before and after -->
  <section class="bg-sand-100 py-16 md:py-24" aria-labelledby="gallery-heading">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>Real jobs</p>
          <h2 id="gallery-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
            Before and after, straight from the van
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-ink-800">
            Same room, same angle, same light. The only thing that changed between the two frames is
            that the soil came out.
          </p>
        </div>
        <a
          href="/before-and-after/"
          class="inline-flex items-center gap-2 rounded-full border-2 border-ink-950/15 px-5 py-3 text-sm font-bold text-ink-950 hover:border-ink-950/45"
        >
          All {galleryPairs.length} jobs
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        {
          showcase.map((p) => (
            <BeforeAfter
              id={p.id}
              label={p.label}
              caption={p.caption}
              beforeAlt={p.beforeAlt}
              afterAlt={p.afterAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <MethodRail />

  <!-- Quote form -->
  <section class="bg-sand-100 py-16 md:py-24" aria-labelledby="quote-heading">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>Your price</p>
        <h2 id="quote-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
          Tell us what you have. We will tell you what it costs.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-800">
          Fill this in and it writes your WhatsApp message for you — you will see exactly what it
          says before anything opens, and you press send yourself. We come back with a price range
          and settle the exact figure with you.
        </p>
        <dl class="mt-9 space-y-5 border-l-2 border-ink-300 pl-6">
          <div>
            <dt class="font-semibold text-ink-950">A range first, then a real number</dt>
            <dd class="mt-1 text-[0.95rem] leading-relaxed text-ink-800">
              Every price on this site is a typical range, because size, fabric and condition all
              move it. We agree your exact figure on the phone or on WhatsApp, and that is what you
              pay — nothing gets added on the day.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-950">An honest answer about stains</dt>
            <dd class="mt-1 text-[0.95rem] leading-relaxed text-ink-800">
              Some marks lift completely, some reduce, and a few are permanent. We will say which is
              which rather than promising a miracle and disappointing you on the day.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-950">No charge if we cannot help</dt>
            <dd class="mt-1 text-[0.95rem] leading-relaxed text-ink-800">
              If a fabric cannot be cleaned safely, we say so on the doorstep and there is nothing
              to pay for the visit.
            </dd>
          </div>
        </dl>
      </div>
      <div class="rounded-card border border-ink-950/10 bg-sand-50 p-6 shadow-lift md:p-9">
        <QuoteForm id="home-quote" />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="container-page py-16 md:py-24" aria-labelledby="reviews-heading">
    <div class="max-w-2xl">
      <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>In their words</p>
      <h2 id="reviews-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
        Messages customers sent us afterwards
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-800">
        Quoted exactly as they were written. You can see the original screenshots on our
        <a class="font-semibold underline underline-offset-4" href="/reviews/">reviews page</a>.
      </p>
    </div>
    <div class="mt-12">
      <ReviewWall />
    </div>
  </section>

  <!-- Areas -->
  <section class="bg-ink-950 py-16 text-sand-50 md:py-24" aria-labelledby="areas-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow text-zest-400"><span class="h-px w-6 bg-zest-400"></span>Where we work</p>
        <h2 id="areas-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
          Across Greater London, borough by borough
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-sand-200/85">
          Every area works slightly differently — parking, building access, the kind of housing, even
          how fast things dry. These pages cover the practical detail for each one.
        </p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          areas.map((a) => (
            <li>
              <a
                href={`/areas/${a.slug}/`}
                class="group flex h-full flex-col rounded-3xl border border-sand-100/15 p-6 transition-colors hover:border-zest-400/60 hover:bg-sand-50/5"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display text-xl font-semibold text-sand-50">{a.name}</h3>
                  <span class="text-sm font-semibold text-zest-400">{a.postcodes[0]}</span>
                </div>
                <p class="mt-2 text-[0.92rem] leading-relaxed text-sand-200/75">{a.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sand-200/70">
        Not on the list? We cover the whole of Greater London —
        <a class="font-semibold text-zest-400 underline underline-offset-4" href="/areas/"
          >check the coverage page</a
        > or just send us your postcode.
      </p>
    </div>
  </section>

  <!-- Guides -->
  <section class="container-page py-16 md:py-24" aria-labelledby="guides-heading">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow text-ink-600"><span class="h-px w-6 bg-ink-600"></span>Worth knowing</p>
        <h2 id="guides-heading" class="mt-3 text-3xl font-semibold md:text-[2.6rem] md:leading-[1.1]">
          Free advice, including when not to call us
        </h2>
      </div>
      <a
        href="/guides/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-ink-950/15 px-5 py-3 text-sm font-bold text-ink-950 hover:border-ink-950/45"
      >
        All guides
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        guides.slice(0, 3).map((g) => (
          <li>
            <a
              href={`/guides/${g.slug}/`}
              class="flex h-full flex-col rounded-card border border-ink-950/10 bg-sand-50 p-7 transition-all hover:-translate-y-1 hover:shadow-lift"
            >
              <p class="text-[0.7rem] font-bold uppercase tracking-[0.14em] text-ink-600">
                {g.readingTime}
              </p>
              <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-ink-950">
                {g.h1}
              </h3>
              <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-800">{g.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq faqs={homeFaqs} lede="If your question is not here, message us — we answer the awkward ones honestly." />

  <CtaBand />
</Base>
