---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas } from '../../data/areas';
import { services } from '../../data/services';
import { site } from '../../data/site';

const allPostcodes = [...new Set(areas.flatMap((a) => a.postcodes))].sort();

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Areas we cover', item: `${site.domain}/areas/` },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'London areas covered by Sofa Cleaning London',
    itemListElement: areas.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `${site.domain}/areas/${a.slug}/`,
    })),
  },
];
---

<Base
  title="Areas We Cover | Sofa & Carpet Cleaning London"
  description="Sofa and carpet cleaning across Greater London, with detailed local pages for Clapham, Balham, Wandsworth, Putney, Fulham, Chelsea, Islington and more."
  schema={schema}
>
  <PageHero
    eyebrow="Coverage"
    title="Where we work across Greater London"
    lede="Same prices everywhere. What changes borough to borough is the practical stuff — parking, permits, building access, the kind of housing and how quickly a room dries."
    trail={[{ href: '/areas/', label: 'Areas we cover' }]}
    chips={[`${areas.length} detailed area pages`, 'Greater London', 'No travel surcharge']}
  />

  <section class="container-page py-16 md:py-20">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        areas.map((a) => (
          <li>
            <a
              href={`/areas/${a.slug}/`}
              class="group flex h-full flex-col rounded-card border border-ink-950/10 bg-sand-50 p-7 transition-all hover:-translate-y-1 hover:border-ink-950/25 hover:shadow-lift"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="font-display text-2xl font-semibold text-ink-950">{a.name}</h2>
                <span class="font-semibold text-ink-600">{a.postcodes[0]}</span>
              </div>
              <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-800">{a.summary}</p>
              <p class="mt-5 text-sm text-ink-700">
                {a.neighbourhoods.slice(0, 3).join(' · ')}
              </p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-ink-700">
                Local detail
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sand-100 transition-colors group-hover:bg-zest-400">
                  <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-sand-100 py-16 md:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-950">
          Postcodes covered by these pages
        </h2>
        <p class="mt-3 leading-relaxed text-ink-800">
          These are the postcode districts our twelve area pages cover in detail. We work well
          beyond them — if yours is not listed, send it to us and we will confirm straight away.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            allPostcodes.map((p) => (
              <li class="rounded-full bg-sand-50 px-3.5 py-2 text-sm font-semibold text-ink-900 ring-1 ring-ink-950/10">
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-display text-2xl font-semibold text-ink-950">
          What we clean, wherever you are
        </h2>
        <p class="mt-3 leading-relaxed text-ink-800">
          Prices do not change by postcode and there is no travel surcharge within Greater London.
        </p>
        <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
          {
            services.map((s) => (
              <li>
                <a
                  href={`/services/${s.slug}/`}
                  class="flex items-center justify-between gap-3 rounded-2xl bg-sand-50 px-4 py-3 text-sm font-semibold text-ink-950 ring-1 ring-ink-950/10 hover:ring-ink-950/35"
                >
                  {s.nav}
                  <span class="font-normal text-ink-600">{s.priceRows[0].range}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure if we come to you?"
    body="Send your postcode on WhatsApp. We will tell you straight away whether we cover it, and what your job would cost."
  />
</Base>
