---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import PriceTable from '../../components/PriceTable.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ReviewWall from '../../components/ReviewWall.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, areaBySlug, areaExists } from '../../data/areas';
import { services, serviceBySlug } from '../../data/services';
import { galleryPairs } from '../../data/gallery';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  areas.map((a) => ({ params: { slug: a.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const area = areaBySlug(slug!)!;

const topServices = area.topServices
  .map((s) => serviceBySlug(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const otherServices = services.filter((s) => !area.topServices.includes(s.slug));

const nearbyLinked = area.nearby.filter(areaExists).map((s) => areaBySlug(s)!);
const nearbyText = area.nearby.filter((s) => !areaExists(s));

/** One gallery pair per top service, so no two area pages show the same set. */
const pairs = topServices
  .map((s) => galleryPairs.filter((p) => p.service === s.slug))
  .flatMap((list, i) => (list.length ? [list[i % list.length]] : []))
  .slice(0, 2);

const url = `${site.domain}/areas/${area.slug}/`;
const priceRows = topServices.map((s) => ({
  item: s.nav,
  range: s.priceRows[0].range,
  note: s.priceRows[0].item,
}));

const schema = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: `Sofa and carpet cleaning in ${area.name}`,
    description: area.metaDescription,
    provider: { '@id': `${site.domain}/#business` },
    url,
    areaServed: [
      { '@type': 'Place', name: `${area.name}, London` },
      ...area.postcodes.map((p) => ({ '@type': 'PostalCodeRangeSpecification', postalCodeBegin: p })),
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: area.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Areas we cover', item: `${site.domain}/areas/` },
      { '@type': 'ListItem', position: 3, name: area.name, item: url },
    ],
  },
];
---

<Base title={area.metaTitle} description={area.metaDescription} schema={schema}>
  <PageHero
    eyebrow={`${area.name}, London`}
    title={`Sofa & Carpet Cleaning in ${area.name}`}
    lede={area.summary}
    trail={[
      { href: '/areas/', label: 'Areas we cover' },
      { href: `/areas/${area.slug}/`, label: area.name },
    ]}
    chips={area.postcodes}
  />

  <div class="container-page grid gap-14 py-14 lg:grid-cols-[1fr_22rem] lg:py-20">
    <article class="prose-body max-w-none">
      {area.intro.map((p) => <p class="text-lg leading-relaxed text-ink-900">{p}</p>)}

      <h2>{area.property.heading}</h2>
      {area.property.body.map((p) => <p>{p}</p>)}

      <section class="not-prose my-14">
        <h2 class="font-display text-2xl font-semibold text-ink-950">
          Most requested in {area.name}
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            topServices.map((s) => (
              <li>
                <a
                  href={`/services/${s.slug}/`}
                  class="flex h-full flex-col rounded-3xl border border-ink-950/10 bg-sand-100 p-6 hover:border-ink-950/30"
                >
                  <h3 class="font-display text-lg font-semibold text-ink-950">{s.nav}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-800">{s.summary}</p>
                  <span class="mt-4 text-sm font-bold text-ink-700">{s.priceRows[0].range}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <h2>{area.access.heading}</h2>
      {area.access.body.map((p) => <p>{p}</p>)}

      <h2>Neighbourhoods we cover in {area.name}</h2>
      <p>
        Our {area.name} coverage runs across {area.postcodes.join(', ')} and the streets between
        them, including {area.neighbourhoods.slice(0, -1).join(', ')} and {area.neighbourhoods.at(-1)}.
        If you are on the edge of one of these, send your postcode and we will confirm — we almost
        certainly cover it.
      </p>

      {
        pairs.length > 0 && (
          <section class="not-prose my-14">
            <h2 class="font-display text-2xl font-semibold text-ink-950">
              Recent work like yours
            </h2>
            <p class="mt-3 leading-relaxed text-ink-800">
              Real customer jobs of the type we are booked for most often in {area.name}. Drag to
              compare.
            </p>
            <div class="mt-8 grid gap-8 sm:grid-cols-2">
              {pairs.map((p) => (
                <BeforeAfter
                  id={p.id}
                  label={p.label}
                  caption={p.caption}
                  beforeAlt={p.beforeAlt}
                  afterAlt={p.afterAlt}
                />
              ))}
            </div>
          </section>
        )
      }

      <section class="not-prose my-14">
        <h2 class="font-display text-2xl font-semibold text-ink-950">
          {area.name} prices
        </h2>
        <p class="mt-3 leading-relaxed text-ink-800">
          The same across Greater London — there is no {area.name} premium and no travel surcharge.
        </p>
        <div class="mt-6">
          <PriceTable
            rows={priceRows}
            note={`Typical ranges for the services booked most often in ${area.name}. We agree your exact price by phone or WhatsApp before booking. See the full price list for everything else.`}
          />
        </div>
      </section>

      <nav class="not-prose my-14 rounded-card border border-ink-950/10 bg-sand-100 p-8" aria-labelledby="nearby-heading">
        <h2 id="nearby-heading" class="font-display text-xl font-semibold text-ink-950">
          We also cover, next door to {area.name}
        </h2>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            nearbyLinked.map((n) => (
              <li>
                <a
                  href={`/areas/${n.slug}/`}
                  class="inline-flex items-baseline gap-2 rounded-full border border-ink-950/15 bg-sand-50 px-4 py-2.5 text-sm font-semibold text-ink-950 hover:border-ink-950/45"
                >
                  {n.name}
                  <span class="text-xs font-normal text-ink-600">{n.postcodes[0]}</span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          nearbyText.length > 0 && (
            <p class="mt-4 text-sm leading-relaxed text-ink-700">
              We also work in{' '}
              {nearbyText
                .map((n) => n.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()))
                .join(', ')}{' '}
              and the surrounding areas at the same rates.
            </p>
          )
        }
      </nav>

      <h2>Everything else we clean in {area.name}</h2>
      <ul class="not-prose mt-5 grid gap-2.5 sm:grid-cols-2">
        {
          otherServices.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}/`}
                class="flex items-center justify-between gap-3 rounded-2xl bg-sand-100 px-4 py-3 text-sm font-semibold text-ink-950 hover:bg-sand-200"
              >
                {s.nav}
                <span class="font-normal text-ink-600">{s.priceRows[0].range}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </article>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-card border border-ink-950/10 bg-sand-50 p-6 shadow-lift">
        <h2 class="font-display text-xl font-semibold text-ink-950">
          Book in {area.name}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-800">
          Price back usually within the hour, then we confirm it with you. {site.hours}.
        </p>
        <div class="mt-5">
          <QuoteForm id={`aside-${area.slug}`} area={area.postcodes[0]} />
        </div>
      </div>
    </aside>
  </div>

  <section class="bg-sand-100 py-16 md:py-20">
    <div class="container-page">
      <h2 class="font-display text-2xl font-semibold text-ink-950">What customers said afterwards</h2>
      <div class="mt-8">
        <ReviewWall />
      </div>
    </div>
  </section>

  <Faq faqs={area.faqs} heading={`Cleaning in ${area.name}: your questions`} />

  <CtaBand context={`upholstery cleaning in ${area.name}`} />
</Base>
