---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guides, guideBySlug } from '../../data/guides';
import { serviceBySlug } from '../../data/services';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  guides.map((g) => ({ params: { slug: g.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const guide = guideBySlug(slug!)!;

const related = guide.relatedServices
  .map((s) => serviceBySlug(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const others = guides.filter((g) => g.slug !== guide.slug).slice(0, 3);
const url = `${site.domain}/guides/${guide.slug}/`;

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: guide.h1,
    description: guide.metaDescription,
    datePublished: `${guide.updated}-01`,
    dateModified: `${guide.updated}-01`,
    author: { '@id': `${site.domain}/#business` },
    publisher: { '@id': `${site.domain}/#business` },
    mainEntityOfPage: url,
    inLanguage: 'en-GB',
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: guide.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site.domain}/guides/` },
      { '@type': 'ListItem', position: 3, name: guide.nav, item: url },
    ],
  },
];
---

<Base title={guide.metaTitle} description={guide.metaDescription} schema={schema}>
  <PageHero
    eyebrow="Guide"
    title={guide.h1}
    lede={guide.summary}
    trail={[
      { href: '/guides/', label: 'Guides' },
      { href: `/guides/${guide.slug}/`, label: guide.nav },
    ]}
    chips={[guide.readingTime, `Updated ${guide.updated}`]}
  />

  <div class="container-page grid gap-14 py-14 lg:grid-cols-[1fr_20rem] lg:py-20">
    <article class="prose-body max-w-2xl">
      {guide.intro.map((p) => <p class="text-lg leading-relaxed text-ink-900">{p}</p>)}
      {
        guide.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            {s.body.map((p) => (
              <p>{p}</p>
            ))}
          </>
        ))
      }
    </article>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <nav class="rounded-card border border-ink-950/10 bg-sand-100 p-6" aria-labelledby="toc-heading">
        <h2 id="toc-heading" class="font-display text-lg font-semibold text-ink-950">In this guide</h2>
        <ol class="mt-4 space-y-2.5 text-sm">
          {
            guide.sections.map((s, i) => (
              <li class="flex gap-2.5 text-ink-800">
                <span class="font-semibold text-ink-600">{String(i + 1).padStart(2, '0')}</span>
                {s.heading}
              </li>
            ))
          }
        </ol>
      </nav>

      <nav class="mt-6 rounded-card border border-ink-950/10 bg-sand-50 p-6" aria-labelledby="guide-services">
        <h2 id="guide-services" class="font-display text-lg font-semibold text-ink-950">
          If you need us
        </h2>
        <ul class="mt-4 space-y-3">
          {
            related.map((r) => (
              <li>
                <a
                  href={`/services/${r.slug}/`}
                  class="font-semibold text-ink-900 underline underline-offset-4 hover:text-ink-950"
                >
                  {r.nav}
                </a>
                <span class="mt-0.5 block text-sm text-ink-700">{r.priceRows[0].range}</span>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>

  <Faq faqs={guide.faqs} heading="Questions on this topic" />

  <section class="bg-sand-100 py-16 md:py-20">
    <div class="container-page">
      <h2 class="font-display text-2xl font-semibold text-ink-950">More guides</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          others.map((g) => (
            <li>
              <a
                href={`/guides/${g.slug}/`}
                class="flex h-full flex-col rounded-card border border-ink-950/10 bg-sand-50 p-6 hover:border-ink-950/30"
              >
                <h3 class="font-display text-lg font-semibold leading-snug text-ink-950">{g.h1}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-ink-800">{g.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
